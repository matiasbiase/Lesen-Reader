<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TEMPLATE: swap /RUTA/A/lesen for wherever the folder actually lives,
       then copy this into ~/Library/LaunchAgents/ so it starts on its own. -->

  <key>Label</key>
  <string>com.lesen.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/RUTA/A/lesen/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>app:app</string>
    <string>--app-dir</string>
    <string>/RUTA/A/lesen/backend</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8777</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/RUTA/A/lesen</string>

  <!-- Starts at login, and comes back on its own if it falls over. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- 5s between retries: if something is genuinely broken, launchd should
       not restart it in a tight loop. -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/RUTA/A/lesen/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/RUTA/A/lesen/data/server.log</string>
</dict>
</plist>
